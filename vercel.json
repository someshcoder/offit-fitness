{
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "env": {
    "NODE_ENV": "production",
    "PORT": "5000"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
